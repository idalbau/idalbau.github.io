---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Esempi di Lavori | Ristrutturazioni IDAL BAU"
  description="Esempi illustrativi delle nostre ristrutturazioni a Merano e Bolzano. Scorri le immagini Prima e Dopo per idee di intervento. IDAL BAU."
  keywords="esempi ristrutturazioni Merano, lavori edili Alto Adige, prima e dopo bagno, Projektbeispiele Sanierung Südtirol, IDAL BAU"
  ogTitle="Esempi di Lavori | IDAL BAU"
  ogDescription="Esempi illustrativi delle nostre ristrutturazioni a Merano e Bolzano. Prima e Dopo per idee e ispirazioni."
  canonicalUrl="https://idalbau.github.io/portfolio.html"
  lang="it"
>
  <div class="page-header">
        <div class="container">
            <h1>Esempi di Lavori</h1>
            <p>Esempi illustrativi di come potrebbe apparire il risultato ideale per il tuo specifico caso.</p>
        </div>
    </div>

    <section class="portfolio-section container">
        <h2 class="section-title">Esempi di <span>Trasformazione</span></h2>

        <div class="slider-grid">
            <!-- SLIDER 1: Ristrutturazione Bagno -->
            <div class="slider-card reveal">
                <h3>Rifacimento Completo Bagno (Esempio 1)</h3>
                <div class="ba-slider">
                    <img src="images/bagno-prima.webp" alt="Bagno prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/bagno-dopo.webp" alt="Bagno dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 2: Rifacimento Completo Bagno - Esempio 2 -->
            <div class="slider-card reveal">
                <h3>Rifacimento Completo Bagno (Esempio 2)</h3>
                <div class="ba-slider">
                    <img src="images/bagno-prima-2.webp" alt="Bagno prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/bagno-dopo-2.webp" alt="Bagno dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 3: Impermeabilizzazione Terrazza -->
            <div class="slider-card reveal">
                <h3>Impermeabilizzazione Terrazza (Esempio 1)</h3>
                <div class="ba-slider">
                    <img src="images/terrazza-prima.webp" alt="Terrazza prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/terrazza-dopo.webp" alt="Terrazza dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 4: Impermeabilizzazione Terrazza - Esempio 2 -->
            <div class="slider-card reveal">
                <h3>Impermeabilizzazione Terrazza (Esempio 2)</h3>
                <div class="ba-slider">
                    <img src="images/terrazza-prima-2.webp" alt="Terrazza prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/terrazza-dopo-2.webp" alt="Terrazza dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 5: Pavimentazioni -->
            <div class="slider-card reveal">
                <h3>Posa Pavimentazioni & Piastrelle</h3>
                <div class="ba-slider">
                    <img src="images/pavimento-prima.webp" alt="Pavimento prima della posa" class="ba-before" loading="lazy">
                    <img src="images/pavimento-dopo.webp" alt="Pavimento dopo la posa" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 6: Cartongesso & Tinteggiature -->
            <div class="slider-card reveal">
                <h3>Opere in Cartongesso & Tinteggiatura</h3>
                <div class="ba-slider">
                    <img src="images/cartongesso-prima.webp" alt="Stanza prima delle opere" class="ba-before" loading="lazy">
                    <img src="images/cartongesso-dopo.webp" alt="Stanza dopo le opere" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 7: Appartamento 1 -->
            <div class="slider-card reveal">
                <h3>Ristrutturazione Appartamento (Esempio 1)</h3>
                <div class="ba-slider">
                    <img src="images/appartamento-prima-1.webp" alt="Appartamento prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/appartamento-dopo-1.webp" alt="Appartamento dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 8: Appartamento 2 -->
            <div class="slider-card reveal">
                <h3>Ristrutturazione Appartamento (Esempio 2)</h3>
                <div class="ba-slider">
                    <img src="images/appartamento-prima-2.webp" alt="Cucina prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/appartamento-dopo-2.webp" alt="Cucina dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>

            <!-- SLIDER 9: Appartamento 3 -->
            <div class="slider-card reveal">
                <h3>Ristrutturazione Appartamento (Esempio 3)</h3>
                <div class="ba-slider">
                    <img src="images/appartamento-prima-3.webp" alt="Camera da letto prima della ristrutturazione" class="ba-before" loading="lazy">
                    <img src="images/appartamento-dopo-3.webp" alt="Camera da letto dopo la ristrutturazione" class="ba-after" loading="lazy">
                    <input type="range" min="0" max="100" value="50" oninput="moveSlider(this)" aria-label="Slider confronto">
                    <div class="slider-handle"></div>
                    <div class="ba-label ba-label-before">Prima</div>
                    <div class="ba-label ba-label-after">Dopo</div>
                </div>
            </div>
        </div>

        <!-- GALLERIA CLASSICA -->
        <h2 class="section-title reveal" style="margin-top: 100px;">Idee e <span>Ispirazioni</span></h2>
        
        <div class="gallery-grid reveal">
            <img src="images/01.webp" class="gallery-item" alt="Lavoro edile IDAL BAU" loading="lazy">
            <img src="images/02.webp" class="gallery-item" alt="Lavoro edile IDAL BAU" loading="lazy">
            <img src="images/03.webp" class="gallery-item" alt="Lavoro edile IDAL BAU" loading="lazy">
            <img src="images/04.webp" class="gallery-item" alt="Lavoro edile IDAL BAU" loading="lazy">
        </div>
    </section>
</BaseLayout>
