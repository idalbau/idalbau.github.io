---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="IDAL BAU di Karasani Fatos | Impresa Edile Merano | Ristrutturazioni Alto Adige"
  description="IDAL BAU: Impresa edile a Merano e Bolzano. Ristrutturazioni chiavi in mano, opere murarie, impermeabilizzazioni e posa pavimentazioni in Alto Adige."
  keywords="impresa edile Merano, muratore Merano, ristrutturazioni chiavi in mano Alto Adige, Maurer Meran, schlüsselfertige Sanierungen Südtirol, IDAL BAU"
  ogTitle="IDAL BAU | Impresa Edile Merano & Bolzano"
  ogDescription="Ristrutturazioni chiavi in mano, impermeabilizzazioni e opere murarie in Alto Adige. Qualità e professionalità al tuo servizio."
  canonicalUrl="https://idalbau.github.io/"
  lang="it"
>
  <!-- ================= HERO SECTION ================= -->
    <section class="hero">
        <div class="hero-slides">
            <div class="hero-slide active" style="background-image: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(183,28,28,0.35) 100%), url('images/hero.webp');"></div>
            <div class="hero-slide" style="background-image: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(183,28,28,0.35) 100%), url('images/hero-bricklayer.webp');"></div>
            <div class="hero-slide" style="background-image: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(183,28,28,0.35) 100%), url('images/og-image-2.webp');"></div>
            <div class="hero-slide" style="background-image: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(183,28,28,0.35) 100%), url('images/hero-3.webp');"></div>
        </div>
        <div class="container" style="position: relative; z-index: 2;">
            <div>
                <h1>L'Impresa Edile di Fiducia<br>in Alto Adige</h1>
                <p>Ristrutturazioni chiavi in mano, impermeabilizzazioni e opere murarie.</p>
                <a href="#contatti" class="btn">Richiedi Sopralluogo</a>
            </div>
        </div>
    </section>

    <!-- ================= SERVIZI ================= -->
    <section id="servizi" class="services reveal">
        <div class="container">
            <h2 class="section-title">I Nostri <span>Servizi</span></h2>

            <div class="services-grid">
                <!-- Servizio 1 -->
                <div class="service-card">
                    <i class="fas fa-home"></i>
                    <h3>Ristrutturazioni Chiavi in Mano</h3>
                    <p>Rifacimento completo di bagni, cucine e appartamenti. Dal massetto alle finiture, gestiamo l'intero progetto.</p>
                    <a href="ristrutturazione-bagno-merano.html" class="service-link">Scopri di più &rarr;</a>
                </div>
                <!-- Servizio 2 -->
                <div class="service-card" id="opere-murarie">
                    <i class="fas fa-trowel-bricks"></i>
                    <h3>Opere Murarie & Demolizioni</h3>
                    <p>Abbattimento e costruzione di tramezze, smaltimento macerie, consolidamento strutturale e scavi.</p>
                </div>
                <!-- Servizio 3 -->
                <div class="service-card" id="impermeabilizzazioni">
                    <i class="fas fa-water"></i>
                    <h3>Impermeabilizzazioni</h3>
                    <p>Risanamento completo di balconi e terrazze. Ricerca perdite d'acqua, posa di guaine e trattamenti protettivi.</p>
                    <a href="impermeabilizzazioni-bolzano.html" class="service-link">Scopri di più &rarr;</a>
                </div>
                <!-- Servizio 4 -->
                <div class="service-card" id="pavimentazioni">
                    <i class="fas fa-layer-group"></i>
                    <h3>Pavimentazioni</h3>
                    <p>Posa di piastrelle, parquet e pavimentazioni esterne carrabili (porfido, betonelle, lastre di Luserna).</p>
                </div>
                <!-- Servizio 5 -->
                <div class="service-card" id="cartongesso">
                    <i class="fas fa-paint-roller"></i>
                    <h3>Cartongesso & Tinteggiature</h3>
                    <p>Controsoffitti, pareti isolanti, rasature a stucco, tinteggiatura interni e facciate esterne.</p>
                </div>
                <!-- Servizio 6 -->
                <div class="service-card" id="manutenzioni-condominiali">
                    <i class="fas fa-building"></i>
                    <h3>Manutenzioni Condominiali</h3>
                    <p>Messa a norma, sostituzione porte tagliafuoco, risanamento facciate e griglie carrabili.</p>
                </div>
                <!-- Servizio 7 -->
                <div class="service-card">
                    <i class="fas fa-tools"></i>
                    <h3>Altri Servizi su Misura</h3>
                    <p>Offriamo inoltre molti altri servizi edili personalizzati. Qualunque sia la vostra esigenza, troviamo la soluzione perfetta e professionale per voi.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CHI SIAMO ================= -->
    <section id="chi-siamo-home" class="about-section reveal">
        <div class="container">
            <h2 class="section-title">Chi <span>Siamo</span></h2>

            <div class="about-content">
                <p>Siamo <strong>IDAL BAU di Karasani Fatos</strong>. Operiamo a Merano e in tutto l'Alto Adige, garantendo un servizio di altissima qualità per privati, condomini e aziende. Che si tratti di riparare un'infiltrazione o di ristrutturare un'intera villa, il nostro approccio non cambia: materiali eccellenti, cantieri puliti e rispetto assoluto delle tempistiche.</p>
                <p>Siamo orgogliosi di offrire un servizio perfettamente bilingue (Italiano e Tedesco).</p>

                <ul class="about-checklist">
                    <li><i class="fas fa-check-circle"></i> <span>Materiali Certificati (Mapei, Röfix, Kerakoll e altri marchi leader)</span></li>
                    <li><i class="fas fa-check-circle"></i> <span>Interlocutore Unico per tutto il cantiere</span></li>
                    <li><i class="fas fa-check-circle"></i> <span>Pronto Intervento per Emergenze</span></li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ================= CONTATTI ================= -->
    <section id="contatti" class="contact reveal">
        <div class="container">
            <h2 class="section-title">Richiedi un <span>Preventivo</span></h2>

            <div class="contact-flex">
                <div class="contact-info">
                    <p><i class="fas fa-map-marker-alt"></i> IDAL BAU di Karasani Fatos<br>Via Portici 254<br>39012 Merano (BZ)</p>
                    <p><i class="fas fa-phone-alt"></i> <a href="tel:+393355652179">+39 335 565 2179</a></p>
                    <p><i class="fas fa-envelope"></i> <a href="mailto:info@idalbau.it">info@idalbau.it</a></p>
                    <p><i class="fas fa-file-invoice"></i> P.IVA: 03151460213</p>
                </div>
                <div class="contact-form">
                    <form action="https://api.web3forms.com/submit" method="POST">
                        <input type="hidden" name="access_key" value="63cc33bc-343a-4ec1-b02f-4b836a57dfe5">
                        <input type="hidden" name="redirect" value="https://idalbau.github.io/grazie.html">

                        <input type="text" name="Nome" placeholder="Nome / Name" required>
                        <input type="tel" name="Telefono" placeholder="Telefono / Telefon" required>
                        <input type="text" name="Indirizzo" placeholder="Indirizzo / Adresse (Opzionale)">
                        <input type="email" name="Email" placeholder="Email (Opzionale)">
                        <textarea name="Messaggio" rows="4" placeholder="Descrivi il lavoro di cui hai bisogno..." required></textarea>

                        <!-- Checkbox GDPR Obbligatoria -->
                        <div class="gdpr-checkbox">
                            <input type="checkbox" id="privacy" name="Privacy" required>
                            <label for="privacy">Dichiaro di aver letto e accetto il trattamento dei dati personali secondo la <a href="privacy-policy.html" style="color:var(--idal-red); text-decoration:underline;" target="_blank">Privacy Policy</a>.</label>
                        </div>

                        <!-- Tracciamento Submit Modulo -->
                        <button type="submit" class="btn"
                            onclick="gtag('event', 'submit_form', {'event_category': 'Lead', 'event_label': 'Modulo_Contatti'});">Invia Richiesta</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= MAPPA ================= -->
    <section class="map reveal">
        <iframe src="https://maps.google.com/maps?q=IDAL+BAU+di+Karasani+Fatos+Via+Portici+254+Merano&t=&z=15&ie=UTF8&iwloc=&output=embed"
                width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" title="IDAL BAU - Via Portici 254, Merano"></iframe>
    </section>
</BaseLayout>
